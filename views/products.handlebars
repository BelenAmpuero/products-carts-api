
{{#each products}}
{{#if this.status}}
<div>
<p>{{this._id}}</p> 
<p>{{this.title}}</p> 
<p>{{this.category}}</p> 
<p>{{this.price}}</p> 
<p>{{this.stock}}</p> 
<p>{{this.description}}</p> 
 {{#if this.thumbnails.length}}
        <p>Imágenes:</p>
        {{#each this.thumbnails}}
          <p>{{this}}</p>
        {{/each}}
      {{/if}}
<div>
<hr>
{{/if}}
{{/each}}



